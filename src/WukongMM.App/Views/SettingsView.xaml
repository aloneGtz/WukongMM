<UserControl x:Class="WukongMM.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WukongMM.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,14,4,4" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{l:Tr '设置', 'Settings'}" Style="{StaticResource PageTitle}" />

            <TextBlock Text="{l:Tr '游戏目录', 'Game folder'}" Style="{StaticResource SectionTitle}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr '应用', 'Apply'}" Command="{Binding ApplyCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="{l:Tr '自动查找', 'Auto-detect'}" Command="{Binding AutoDetectCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="{l:Tr '浏览…', 'Browse…'}" Command="{Binding BrowseCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" />
                <TextBox Text="{Binding GameRootInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="420" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="{l:Tr '选择包含 b1 文件夹和 b1.exe 的那一层目录，例如 G:\\SteamLibrary\\steamapps\\common\\BlackMythWukong。', 'Choose the folder that contains the b1 folder and b1.exe, for example G:\\SteamLibrary\\steamapps\\common\\BlackMythWukong.'}" />

            <TextBlock Text="{l:Tr '启动游戏', 'Launching the game'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
            <CheckBox Content="{l:Tr '启动游戏时附加 -fileopenlog 参数（Pak 类 mod 生效需要）', 'Add -fileopenlog when launching the game (needed for pak mods)'}" IsChecked="{Binding LaunchWithFileOpenLog}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="{l:Tr '右上角的启动按钮会直接运行 b1\\Binaries\\Win64\\b1-Win64-Shipping.exe。如果你习惯从 Steam 启动，也可以在 Steam → 游戏属性 → 启动选项里填写 -fileopenlog。', 'The launch button at the top right runs b1\\Binaries\\Win64\\b1-Win64-Shipping.exe directly. If you prefer launching from Steam, add -fileopenlog under Steam → Properties → Launch Options.'}" />

            <TextBlock Text="{l:Tr '游戏数据导出 mod（WukongMMDataExport）', 'Game data export mod (WukongMMDataExport)'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{l:Tr '管理器自带的 CSharpLoader mod，只读：读档后把道具表、等级表、道具用途表导出到 b1\\ModManager\\GameData。存档页靠它显示道具名称、判断哪些道具可以修改。', 'A read-only CSharpLoader mod bundled with the manager: after a save is loaded it exports the item, level and item-usage tables to b1\\ModManager\\GameData. The save editor uses them for item names and to decide which items are editable.'}" />
            <TextBlock Text="{Binding ExportModStatusText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button Content="{l:Tr '安装 / 更新导出 mod', 'Install / update the export mod'}" Command="{Binding InstallExportModCommand}" Style="{StaticResource ToolbarButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="{l:Tr '数据存放位置', 'Data locations'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr '应用设置和道具名称备注：', 'App settings and item name notes:'}" />
            <DockPanel Margin="0,4,0,10">
                <Button DockPanel.Dock="Right" Content="{l:Tr '打开', 'Open'}" Command="{Binding OpenAppDataCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" />
                <TextBox Text="{Binding AppDataDirectory, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr 'mod 备注、禁用仓库（Disabled）、存档备份（SaveBackups）：游戏目录\\b1\\ModManager', 'Mod notes, the disabled-mod store (Disabled) and save backups (SaveBackups): game folder\\b1\\ModManager'}" />
            <Button Content="{l:Tr '打开 ModManager 文件夹', 'Open the ModManager folder'}" Command="{Binding OpenManagerDataCommand}" Style="{StaticResource ToolbarButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="{l:Tr '关于', 'About'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="{l:Tr '单机游戏辅助工具。修改存档有风险，请保留备份；本工具不会联网，也不会上传任何数据。', 'An offline helper for a single-player game. Editing saves is risky, so keep backups. This tool never goes online and uploads nothing.'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
