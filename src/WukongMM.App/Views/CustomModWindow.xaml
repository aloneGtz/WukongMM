<Window x:Class="WukongMM.App.Views.CustomModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WukongMM.App.Infrastructure"
        Title="{l:Tr '新建自定义 mod', 'New custom mod'}"
        Width="640" Height="460" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="{l:Tr '把游戏目录（b1）里的若干文件或文件夹组合成一个 mod，之后可以整体启用/禁用。适合布局特殊的 mod 和你自己做的 mod。只能选择当前在游戏目录里的文件，原版文件不能选。', 'Group several files or folders in the game folder (b1) into one mod that can be enabled or disabled as a whole. Useful for unusually laid-out mods and your own mods. Only files currently in the game folder can be chosen; original game files cannot.'}" />

        <TextBlock Grid.Row="1" Text="{l:Tr '名称', 'Name'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="NameBox" Margin="0,0,0,10" />

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="{l:Tr '包含的文件 / 文件夹', 'Files / folders'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <ListBox x:Name="PathList" />
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{l:Tr '添加文件…', 'Add files…'}" Click="AddFiles_Click" Style="{StaticResource ToolbarButton}" />
            <Button Content="{l:Tr '添加文件夹…', 'Add folders…'}" Click="AddFolders_Click" Style="{StaticResource ToolbarButton}" />
            <Button Content="{l:Tr '移除所选', 'Remove selected'}" Click="Remove_Click" Style="{StaticResource ToolbarButton}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Tr '创建', 'Create'}" Click="Ok_Click" IsDefault="True" Padding="20,5" Margin="0,0,8,0" />
            <Button Content="{l:Tr '取消', 'Cancel'}" IsCancel="True" Padding="20,5" />
        </StackPanel>
    </Grid>
</Window>
