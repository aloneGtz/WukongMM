<Window x:Class="WukongMM.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="720" MaxHeight="720"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- 自己的消息框：按钮文字随界面语言（系统 MessageBox 的按钮语言由 Windows 决定）。
         AutomationId 沿用 Win32 MessageBox 的编号（65535 = 正文，1 = 确定，6 = 是，7 = 否），UI 测试脚本靠它们定位 -->
    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                   VerticalAlignment="Top" Margin="0,0,16,0" />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.AutomationId="65535" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="YesButton" AutomationProperties.AutomationId="6" MinWidth="90" Padding="16,5" Margin="0,0,8,0" Click="Yes_Click" />
            <Button x:Name="NoButton" AutomationProperties.AutomationId="7" MinWidth="90" Padding="16,5" Click="No_Click" />
            <Button x:Name="OkButton" AutomationProperties.AutomationId="1" MinWidth="90" Padding="16,5" Click="Yes_Click" />
        </StackPanel>
    </Grid>
</Window>
