<Window x:Class="WukongMM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WukongMM.App.Views"
        xmlns:l="clr-namespace:WukongMM.App.Infrastructure"
        Title="{l:Tr '黑神话：悟空 Mod 管理器', 'Black Myth: Wukong Mod Manager'}"
        Width="1280" Height="820" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" Background="#FF0E0E10">
    <Grid>
    <!-- 背景图靠右上对齐（人物在右侧）；上面盖一层左深右浅的暗色遮罩，保证文字清晰 -->
    <Border IsHitTestVisible="False">
        <Border.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top" />
        </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#E80E0E10" />
                <GradientStop Offset="0.5" Color="#C80E0E10" />
                <GradientStop Offset="1" Color="#8C0E0E10" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <Grid Margin="20,14,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：游戏目录 + 运行状态 + 语言 + 启动按钮 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Tr '黑神话：悟空 Mod 管理器', 'Black Myth: Wukong Mod Manager'}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GameRootText}" Style="{StaticResource Hint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameStatusText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="{l:Tr 'English', '中文'}" Command="{Binding ToggleLanguageCommand}" Padding="12,6" Margin="0,0,8,0"
                        AutomationProperties.Name="Language"
                        ToolTip="{l:Tr '切换界面语言（Switch to English）', 'Switch the interface language (切换到中文)'}" />
                <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchGameCommand}" Padding="14,6" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{l:Tr 'Mod 管理', 'Mods'}">
                <views:ModsView DataContext="{Binding Mods}" />
            </TabItem>
            <TabItem Header="{l:Tr '存档修改', 'Save Editor'}">
                <views:SaveEditorView DataContext="{Binding Saves}" />
            </TabItem>
            <TabItem Header="{l:Tr '设置', 'Settings'}">
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="2,8,0,0" />
    </Grid>
    </Grid>
</Window>
