<UserControl x:Class="WukongMM.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WukongMM.App.Infrastructure">
    <Grid Margin="4,14,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{l:Tr 'Mod 管理', 'Mod Manager'}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:Tr '勾选或取消勾选，即可单独启用或禁用某个 mod。禁用的 mod 会移到“禁用仓库”（游戏目录\\b1\\ModManager\\Disabled），不会删除，随时可以再启用。', 'Tick or untick a mod to enable or disable it individually. Disabled mods are moved to the disabled store (game folder\\b1\\ModManager\\Disabled); nothing is deleted and you can enable them again at any time.'}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Text="{l:Tr '游戏正在运行：请先退出游戏，再启用或禁用 mod。', 'The game is running: quit the game before enabling or disabling mods.'}" />
            </Border>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding HasActiveConflicts, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding ActiveConflictText}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding ShowFileOpenLogHint, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap"
                           Text="{l:Tr '提示：Pak 类 mod 需要带 -fileopenlog 参数启动游戏才会生效。可以到“设置”页勾选“启动游戏时附加 -fileopenlog”，再用右上角的按钮启动；也可以在 Steam 的启动选项里填写 -fileopenlog。', 'Tip: pak mods only work when the game is launched with -fileopenlog. Turn on “Add -fileopenlog when launching the game” on the Settings page and use the launch button at the top right, or add -fileopenlog to the Steam launch options.'}" />
            </Border>
            <TextBlock Text="{Binding FrameworkText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
            <Button Content="{l:Tr '刷新', 'Refresh'}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" />
            <Button Content="{l:Tr '打开 ~mods 文件夹', 'Open ~mods folder'}" Command="{Binding OpenModsFolderCommand}" Style="{StaticResource ToolbarButton}" />
            <Button Content="{l:Tr '打开禁用仓库', 'Open disabled store'}" Command="{Binding OpenDisabledStoreCommand}" Style="{StaticResource ToolbarButton}" />
            <Button Content="{l:Tr '新建自定义 mod…', 'New custom mod…'}" Command="{Binding NewCustomModCommand}" Style="{StaticResource ToolbarButton}"
                    ToolTip="{l:Tr '把游戏目录里任意文件/文件夹组合成一个 mod，用于布局特殊的 mod 或自制 mod', 'Group any files or folders in the game folder into one mod, for unusually laid-out mods or your own mods'}" />
            <ComboBox DockPanel.Dock="Right" Width="130" Margin="8,0,0,0"
                      ItemsSource="{Binding StateFilters}" SelectedIndex="{Binding StateFilterIndex}" />
            <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0"
                      ItemsSource="{Binding KindFilters}" SelectedIndex="{Binding KindFilterIndex}" />
            <TextBox DockPanel.Dock="Right" Width="200" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr '搜索名称 / 路径 / 备注', 'Search name / path / notes'}" />
            <TextBlock DockPanel.Dock="Right" Text="{l:Tr '搜索', 'Search'}" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Bottom" Margin="2,6,0,0">
                    <CheckBox DockPanel.Dock="Right" Content="{l:Tr '显示框架内置组件', 'Show built-in framework components'}" IsChecked="{Binding ShowFrameworkBuiltin}" FontSize="12"
                              ToolTip="{l:Tr 'UE4SS 自带的内置脚本（BPModLoaderMod 等）属于框架的一部分，随框架入口一起生效，平时不需要单独开关', 'Scripts bundled with UE4SS (BPModLoaderMod etc.) are part of the framework and work together with it; you normally do not need to toggle them'}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Hint}" />
                </DockPanel>
                <Grid>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr '启用', 'On'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  ToolTip="{l:Tr '勾选 = 启用，取消勾选 = 禁用', 'Ticked = enabled, unticked = disabled'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Tr '名称', 'Name'}" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="{l:Tr '类型', 'Type'}" Binding="{Binding KindText}" Width="160" />
                            <DataGridTextColumn Header="{l:Tr '状态', 'State'}" Binding="{Binding StateText}" Width="75" />
                            <DataGridTemplateColumn Header="{l:Tr '冲突', 'Conflicts'}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ConflictBadge}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   ToolTip="{l:Tr '和其他 pak 类 mod 改了相同的游戏文件。⚠ = 正在冲突（双方都已启用）的 mod 数；不带 ⚠ 的数字 = 可能冲突（其中一方已禁用）。选中后在右侧查看详情。', 'Changes the same game files as other pak mods. ⚠ = number of mods currently in conflict (both enabled); a plain number = potential conflicts (one side disabled). Select the row to see details on the right.'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveResourceConflict}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFB900" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Tr '大小', 'Size'}" Binding="{Binding SizeText}" Width="85" />
                            <DataGridTextColumn Header="{l:Tr '修改时间', 'Modified'}" Binding="{Binding ModifiedText}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource Hint}" FontSize="14"
                               Text="{l:Tr '还没有发现任何 mod。&#x0a;按作者的说明把 mod 放进游戏目录（例如 b1\\Content\\Paks\\~mods），然后点“刷新”。', 'No mods found yet.&#x0a;Put mods into the game folder as their authors describe (e.g. b1\\Content\\Paks\\~mods), then click Refresh.'}" />
                </Grid>
            </DockPanel>

            <!-- 详情 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:Tr '选择左侧的一个 mod 查看详情', 'Select a mod on the left to see its details'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8">
                                <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="　·　" /><Run Text="{Binding StateText, Mode=OneWay}" /><Run Text="　·　" /><Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>
                            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{l:Tr '显示名称（留空则用文件名）', 'Display name (empty = file name)'}" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{l:Tr '来源链接', 'Source link'}" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding EditSourceUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{l:Tr '备注', 'Notes'}" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{l:Tr '保存备注', 'Save notes'}" Command="{Binding SaveMetadataCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,8" />
                            <Button Content="{l:Tr '打开所在位置', 'Open location'}" Command="{Binding OpenSelectedLocationCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,8" />
                            <Button Content="{l:Tr '打开来源链接', 'Open source link'}" Command="{Binding OpenSourceUrlCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,8" />
                            <Button Content="{l:Tr '删除自定义分组', 'Delete custom group'}" Command="{Binding RemoveCustomModCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,8"
                                    Visibility="{Binding Selected.IsCustom, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                        </WrapPanel>

                        <StackPanel DataContext="{Binding Selected}">
                            <StackPanel Visibility="{Binding HasResourceConflict, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:Tr '资源冲突', 'Resource conflicts'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                           Text="{l:Tr '下面这些 mod 改了相同的游戏文件，同时启用时只有一个生效：', 'These mods change the same game files; only one takes effect when both are enabled:'}" />
                                <TextBlock Text="{Binding ConflictDetailText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasPakContent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:Tr 'Pak 内容', 'Pak contents'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding PakContentText}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBlock Text="{l:Tr '位置（相对游戏的 b1 目录）', 'Location (relative to the game b1 folder)'}" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding LocationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Tr '包含的文件', 'Files'}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Hint}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
